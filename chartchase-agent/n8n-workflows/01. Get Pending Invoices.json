    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const req = item.json.overdue_requests;\n  \n  return {\n    json: {\n      requestor_organization_name: req.requestor_organization_name,\n      provider_name:               req.provider_name,\n      organization_service_level:  req.organization_service_level,\n      requestor_contact_number:    req.requestor_contact_number,\n      requestor_email:             req.requestor_email,\n      requestor_name:              req.requestor_name,\n      request_count:               req.request_count,\n      request_id:                  req.request_ids.map(r => r.request_id).join(', '),\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        -112
      ],
      "id": "145a6224-0d83-4ee0-b58a-d37a2010b7f5",
      "name": "Format invoice data"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const req = item.json.overdue_requests;\n  \n  // Extract individual fields from request_ids array of objects\n  const ids = req.request_ids.map(r => r.request_id);\n  const invoiceAmounts = req.request_ids.map(r => r.invoice_amount);\n  const patientNames = req.request_ids.map(r => r.patient_name);\n  const daysPastDue = req.request_ids.map(r => r.days_past_due);\n  const totalInvoiceAmount = Math.round(invoiceAmounts.reduce((sum, a) => sum + a, 0) * 100) / 100;\n\n  return {\n    json: {\n      requestor_organization_name: req.requestor_organization_name,\n      provider_name:               req.provider_name,\n      organization_service_level:  req.organization_service_level,\n      requestor_contact_number:    req.requestor_contact_number,\n      requestor_email:             req.requestor_email,\n      requestor_name:              req.requestor_name,\n      request_count:               req.request_count,\n      request_ids:                 ids.join(', '),\n      invoice_amounts:             JSON.stringify(invoiceAmounts),\n      patient_names:               patientNames.join(', '),\n      days_past_due_list:          JSON.stringify(daysPastDue),\n      total_invoice_amount:        totalInvoiceAmount,\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        160
      ],
      "id": "3ef75497-8db5-4969-90bd-144eacce1bbb",
      "name": "Format invoice data1"
    },
