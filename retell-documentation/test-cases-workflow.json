    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cfg = $('Config').first().json;\nconst row = $json;\n\nconst pick = (v, d) => (v !== undefined && v !== null && String(v).trim() !== '') ? String(v).trim() : d;\nconst normPhone = (p) => { let s = String(p == null ? '' : p).trim(); if (!s) return s; return s.charAt(0) === '+' ? s : '+' + s; };\n\nconst dynamic_variables = {\n  Name: pick(row.dyn_Name, cfg.default_name),\n  Phone: normPhone(pick(row.dyn_Phone, cfg.default_phone)),\n  Email: pick(row.dyn_Email, cfg.default_email),\n  current_time: pick(row.dyn_current_time, cfg.default_current_time),\n};\n\nconst splitLines = (s) => String(s || '').split('\\n').map(x => x.trim()).filter(x => x.length > 0);\n\nconst metrics = [...splitLines(row.success_criteria), ...splitLines(cfg.global_criteria)];\n\nlet tool_mocks = [];\nconst tm = String(row.tool_mocks_json || '').trim();\nif (tm) { try { tool_mocks = JSON.parse(tm); } catch (e) { tool_mocks = []; } }\n\nconst payload = {\n  name: row.name,\n  response_engine: { type: 'retell-llm', llm_id: cfg.llm_id },\n  user_prompt: row.user_persona,\n  metrics: metrics,\n  dynamic_variables: dynamic_variables,\n  llm_model: pick(row.llm_model, cfg.default_llm_model),\n};\nif (Array.isArray(tool_mocks) && tool_mocks.length) payload.tool_mocks = tool_mocks;\n\nreturn {\n  test_id: row.test_id,\n  row_number: row.row_number,\n  existing_id: pick(row.test_case_definition_id, ''),\n  payload: payload,\n};"
      },
